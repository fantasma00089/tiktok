# =====================================================================
#  TikTok Repost Monitor — configuração
#  Copie para backend/.env e ajuste. Veja docs/CONFIGURACAO.md.
# =====================================================================

# --- Alvo -------------------------------------------------------------
# @ do perfil (sem o @) e/ou user_id numérico. Pelo menos um é obrigatório.
TIKTOK_USERNAME=perfil_exemplo
TIKTOK_USER_ID=

# --- Provedor de dados ------------------------------------------------
# browser | mock | http | apify | tiktok_research
#   browser         -> PADRÃO. Sem API e sem conta: abre o perfil num navegador invisível
#                      (no Windows, o Edge que já vem instalado) e lê a aba "Reposts".
#   mock            -> SIMULAÇÃO: NÃO lê o TikTok (só reposts de teste do comando simulate)
#   http            -> qualquer API REST/JSON (PrimeApi, YepAPI, RapidAPI, tikwm...)
#   apify           -> Actor da Apify Store
#   tiktok_research -> API oficial de pesquisa do TikTok (requer aprovação)
PROVIDER=browser

# browser
BROWSER_HEADLESS=true          # false = mostra a janela do navegador durante a verificação
BROWSER_TIMEOUT_SECONDS=45
# Navegador: msedge (padrão no Windows), chrome, ou vazio = Chromium do Playwright
#BROWSER_CHANNEL=msedge

# mock
MOCK_FILE=data/mock_reposts.json

# http (exemplo genérico; placeholders {username} e {user_id})
HTTP_API_URL=https://api.exemplo.com/v1/tiktok/user/reposts?username={username}&count=20
HTTP_API_METHOD=GET
# JSON com cabeçalhos (ex.: chave da API)
HTTP_API_HEADERS={"X-API-Key": "SUA_CHAVE"}
# Corpo JSON opcional (para POST)
HTTP_API_BODY=
# Caminho da lista de vídeos no JSON de resposta (vazio = detecção automática)
HTTP_API_ITEMS_PATH=
# Caminhos dos campos em cada item (vazio = detecção automática)
HTTP_API_ID_FIELD=
HTTP_API_URL_FIELD=
HTTP_API_AUTHOR_FIELD=
HTTP_API_DESCRIPTION_FIELD=
HTTP_API_COVER_FIELD=

# apify  (recomendado para começar: só precisa do token)
# Crie conta grátis em apify.com e copie o token em Settings → API & Integrations.
APIFY_TOKEN=
# Opcional: outro Actor e sua entrada em JSON ({username} é substituído).
# Vazio = maximedupre/tiktok-reposts com {"profiles": ["https://www.tiktok.com/@{username}"], "maxItemsPerProfile": 10}
APIFY_ACTOR=
APIFY_INPUT=
APIFY_ITEMS_FILTER_PATH=

# tiktok_research
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_RESEARCH_FIELDS=id,create_time
TIKTOK_RESEARCH_MAX_COUNT=20

# --- Polling e resiliência (RF-03 / RNF-05) ---------------------------
POLL_INTERVAL_SECONDS=180      # 2–5 min recomendado; mínimo aceito: 30
POLL_JITTER_SECONDS=15         # variação aleatória para não bater sempre no mesmo segundo
MAX_BACKOFF_SECONDS=1800       # teto do backoff exponencial após falhas seguidas
RETRY_ATTEMPTS=3               # tentativas por requisição HTTP
RETRY_BASE_DELAY_SECONDS=2
HTTP_TIMEOUT_SECONDS=30

# --- Detecção ---------------------------------------------------------
ALERT_WINDOW_MINUTES=60        # por quanto tempo /status responde "repostou": true
BASELINE_ON_FIRST_RUN=true     # 1ª leitura só registra os reposts existentes (sem alertar)

# --- Servidor local (painel + /status) --------------------------------
HOST=127.0.0.1                 # use 0.0.0.0 se o OpenHands (Docker) precisar acessar a API
PORT=8000
CORS_ORIGINS=*                 # ex.: https://seu-site.netlify.app
ADMIN_TOKEN=                   # token para rotas /api/* fora do localhost (agente em Docker)

# --- Notificações locais ----------------------------------------------
DESKTOP_NOTIFICATIONS=true     # toast nativo (Windows/macOS/Linux)
OPEN_BROWSER_ON_REPOST=false   # abre o vídeo automaticamente no navegador

# --- Webhook reverso: publicar status.json na Netlify -----------------
# Alternativa ao tunnel: o monitor faz deploy do site com o status atualizado.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
NETLIFY_SITE_DIR=../site
NETLIFY_MIN_INTERVAL_SECONDS=60
NETLIFY_HEARTBEAT_MINUTES=0    # >0 republica periodicamente (mostra "monitor online"); ex.: 60

# --- Webhook genérico (opcional) --------------------------------------
WEBHOOK_URL=
WEBHOOK_SECRET=

# --- Arquivos e logs --------------------------------------------------
DATA_DIR=data
LOG_DIR=logs
LOG_LEVEL=INFO
